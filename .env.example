# ==============================================================================
# BuildHub Enterprise Workspace Platform — Environment Configuration Template
# Copy this file or the respective backend/.env.example and frontend/.env.example
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=production
TRUST_PROXY=false

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_management_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false
DB_POOL_MAX=20
# DATABASE_URL=postgres://user:password@hostname:5432/task_management_db?sslmode=require

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=1d

# Default System Administrator Bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_min_8_chars

# Application & CORS URLs
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Email Service Provider (Optional SMTP settings; defaults to sandbox)
EMAIL_FROM=noreply@buildhub.local
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=smtp_user
# EMAIL_PASSWORD=smtp_password

# Rate Limiting Configuration (Optional overrides)
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=500
# RATE_LIMIT_BULK_WINDOW_MS=60000
# RATE_LIMIT_BULK_MAX=100
# RATE_LIMIT_API_WINDOW_MS=900000
# RATE_LIMIT_API_MAX=2000
# DISABLE_RATE_LIMIT=false

# Frontend Configuration (frontend/.env)
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_APP_NAME=BuildHub
