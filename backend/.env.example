# Server Configuration
PORT=5000
NODE_ENV=production
# Set to true if deployed behind reverse proxies (Nginx, AWS ALB, Cloudflare)
TRUST_PROXY=false

# PostgreSQL Database Configuration
# Option A: Discrete Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_management_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false
DB_POOL_MAX=20

# Option B: Single Connection String (e.g., Supabase, Neon, Render, AWS RDS)
# DATABASE_URL=postgres://user:password@hostname:5432/task_management_db?sslmode=require

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=1d

# Default Bootstrap Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_min_8_chars

# CORS Origin (comma-separated or * for wildcard)
CORS_ORIGIN=*

# Frontend Application URL (for password reset and email verification links)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Email Service Provider Configuration (Optional SMTP settings; fallbacks to sandbox)

# Rate Limiting Configuration (Optional overrides)
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=500
# RATE_LIMIT_BULK_WINDOW_MS=60000
# RATE_LIMIT_BULK_MAX=100
# RATE_LIMIT_API_WINDOW_MS=900000
# RATE_LIMIT_API_MAX=2000
# DISABLE_RATE_LIMIT=false

